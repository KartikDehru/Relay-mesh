# Example env for a single relay hop (never commit real private keys).
# Full multi-hop setup: see docs/deploy.md and packages/relay-node/.env.example

ROLE=entry
PORT=4001
RELAY_PRIVATE_KEY=
RELAY_PUBLIC_KEY=
NEXT_HOP_URL=http://127.0.0.1:4002
ALLOWED_HOP_URLS=http://127.0.0.1:4001,http://127.0.0.1:4002,http://127.0.0.1:4003
EXIT_RPC_ALLOWLIST={"11155111":"https://ethereum-sepolia-rpc.publicnode.com"}
DEMO_LOGGING=false
MIX_DELAY_MS_MIN=0
MIX_DELAY_MS_MAX=0
UPSTREAM_TIMEOUT_MS=10000
RATE_LIMIT_PER_MINUTE=60
