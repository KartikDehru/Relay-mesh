# Example env for a single relay hop (never commit real private keys).
# Full multi-hop setup: see DEPLOY.md and packages/relay-node/.env.example

ROLE=entry
PORT=4001
RELAY_PRIVATE_KEY=
RELAY_PUBLIC_KEY=
NEXT_HOP_URL=http://127.0.0.1:4002
EXIT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEMO_LOGGING=false
MIX_DELAY_MS_MIN=0
MIX_DELAY_MS_MAX=0
