# entry | middle | exit
ROLE=entry

# Base64 x25519 private key (from `pnpm generate-keys`)
RELAY_PRIVATE_KEY=

# Optional: public key (base64) for /health fingerprint
RELAY_PUBLIC_KEY=

# Injected by Railway in production; local defaults shown
PORT=4001

# entry/middle: next hop base URL (onion payload also carries nextHopUrl)
NEXT_HOP_URL=http://127.0.0.1:4002

# exit: pinned RPC endpoint (overrides onion rpcTargetUrl when set)
EXIT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Phase 3: allow exit to log plaintext for capture demo
DEMO_LOGGING=false

# Phase 3: optional mixing delay range (ms)
MIX_DELAY_MS_MIN=0
MIX_DELAY_MS_MAX=0
