ROLE=any
PORT=4000
RELAY_PRIVATE_KEY=
RELAY_PUBLIC_KEY=

# Comma-separated hop base URLs this node may forward to (no trailing slash).
# Prefer this in production. If unset, hops are loaded once at boot from
# CIRCUIT_REGISTRY_URL or CIRCUIT_REGISTRY_PATH.
ALLOWED_HOP_URLS=https://hop1.example,https://hop2.example,https://hop3.example

# JSON map of chainId -> https RPC URL. Exit only calls a URL that exactly
# matches the onion's rpcTargetUrl AND appears as a value here.
EXIT_RPC_ALLOWLIST={"1":"https://ethereum.example","11155111":"https://ethereum-sepolia-rpc.publicnode.com"}

# Optional: fetch public registry for hop allowlist at boot
# CIRCUIT_REGISTRY_URL=https://raw.githubusercontent.com/KartikDehru/Relay-mesh/main/circuit-registry.json
# CIRCUIT_REGISTRY_PATH=/app/circuit-registry.json

# EXIT_RPC_URL is ignored (kept only so old deploys do not crash on leftover env).

NEXT_HOP_URL=
DEMO_LOGGING=false
MIX_DELAY_MS_MIN=40
MIX_DELAY_MS_MAX=180
UPSTREAM_TIMEOUT_MS=10000
RATE_LIMIT_PER_MINUTE=60
